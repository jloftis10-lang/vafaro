# Supabase — server-side only, do NOT prefix with NEXT_PUBLIC_.
# From your Supabase project's Settings > API page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — from your Resend dashboard's API Keys page.
RESEND_API_KEY=
RESEND_FROM_EMAIL="OwnerGauge <reports@yourdomain.com>"

# Public — safe to expose to the browser. Where the "Schedule a Confidential
# Conversation" CTA links to on the assessment results page. Until this is
# set, that CTA falls back to scrolling to the on-page email capture form.
NEXT_PUBLIC_BOOKING_URL=

# Microsoft Clarity — public project ID from Clarity > Settings > Overview.
# Optional override for the configured OwnerGauge project. Assessment
# answers/results are explicitly masked from recordings in the application.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Provisioned by the Neon integration in Vercel. Never commit its value.
DATABASE_URL=

# Optional additional protection for anonymized rate-limit identifiers.
LEAD_HASH_SALT=

# Reviewer notifications. RESEND_API_KEY is server-only and should be stored as a sensitive Vercel variable.
RESEND_API_KEY=
REVIEWER_NOTIFICATION_EMAIL=
VAFARO_NOTIFICATION_FROM=Vafaro <reviews@vafaro.com>

# Stripe-hosted one-time checkout. These values are server-only and must be stored as sensitive Vercel variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public canonical origin used for Stripe success and cancellation redirects.
NEXT_PUBLIC_SITE_URL=https://www.vafaro.com

# Optional: used by a future live recommendation endpoint.
OPENAI_API_KEY=
